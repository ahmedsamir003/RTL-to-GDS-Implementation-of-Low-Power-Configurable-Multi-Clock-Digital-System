##Data Import Section

read_file -type sgdc sgdc/system_top.sgdc
read_file -type verilog ../rtl/ALU.v
read_file -type verilog ../rtl/Async_fifo.v
read_file -type verilog ../rtl/CLK_GATE.v
read_file -type verilog ../rtl/ClkDiv.v
read_file -type verilog ../rtl/ClkDiv_mux.v
read_file -type verilog ../rtl/data_sampling.v
read_file -type verilog ../rtl/Data_Sync.v
read_file -type verilog ../rtl/deserializer.v
read_file -type verilog ../rtl/DF_Sync.v
read_file -type verilog ../rtl/edge_bit_counter.v
read_file -type verilog ../rtl/fifo_mem.v
read_file -type verilog ../rtl/fifo_rd.v
read_file -type verilog ../rtl/fifo_wr.v
read_file -type verilog ../rtl/FSM_RX.v
read_file -type verilog ../rtl/FSM_TX.v
read_file -type verilog ../rtl/MUX_TX.v
read_file -type verilog ../rtl/parity_calc.v
read_file -type verilog ../rtl/Parity_Check.v
read_file -type verilog ../rtl/PULSE_GEN.v
read_file -type verilog ../rtl/Register_File.v
read_file -type verilog ../rtl/RST_SYNC.v
read_file -type verilog ../rtl/serializer.v
